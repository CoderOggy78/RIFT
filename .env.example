# RIFT Environment Configuration
RIFT_API_PORT=8000
RIFT_WEB_PORT=5173
DATABASE_URL=sqlite:///./rift.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI Inference Engine Configuration (Google Gemma via Ollama)
RIFT_INFERENCE_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma4:e2b
GEMMA_TIMEOUT_SECONDS=180
GEMMA_MAX_CONCURRENT_REQUESTS=1
GEMMA_MAX_CONTEXT_TOKENS=8192
GEMMA_TEMPERATURE=0.1

# Optional: Cloud Provider API Key (Requires explicit developer authorization)
OLLAMA_API_KEY=
